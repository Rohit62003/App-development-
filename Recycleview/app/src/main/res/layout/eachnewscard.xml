<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:elevation="5dp"
    app:cardCornerRadius="15dp"
    android:layout_margin="10dp"
    android:id="@+id/cardviewitems">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/img3"
            android:scaleType="centerCrop"
            android:layout_margin="10dp"
            android:id="@+id/headingimg"
            app:shapeAppearanceOverlay="@style/softcornerimg">

        </com.google.android.material.imageview.ShapeableImageView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:id="@+id/tvheadline"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:text="@string/credibility_is_the_new_currency_why_winning_ai_recognition_is_the_ultimate_growth_hack_for_startups"
            />



    </LinearLayout>
</androidx.cardview.widget.CardView>